# =============================================================================
# Environment template
# =============================================================================
# Copied to .env by `composer setup`.
# Uncommented lines are the working local defaults; commented lines are optional overrides, shown with their effective default where one exists.
# Every backing service referenced here ships in docker/compose.dev.yaml (pgsql, redis, mailpit, keycloak, plus opt-in horizon, cluster and sentinel profiles).

# --- Application -----------------------------------------------------------
APP_NAME=Acme
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# --- Localization ----------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,ro
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Bucharest

# --- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Credentials match the pgsql service in docker/compose.dev.yaml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=acme_web
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Redis -----------------------------------------------------------------
# Standalone topology by default: cache, sessions, and the queue each sit on their own database index of one server (config/database.php).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Topology switch: standalone (default) | sentinel | cluster (config/database.php).
#
# Redis Cluster: list every node in REDIS_CLUSTER_SEEDS (host, host:port, [v6] or [v6]:port, port defaults to 6379; fallback: REDIS_HOST:REDIS_PORT).
# All four connections move onto the cluster: the queue name gains a {hash tag}, sessions isolate by key prefix, REDIS_USERNAME/
# REDIS_PASSWORD authenticate the whole cluster, and the bounded socket timeouts apply. Details: docs/redis.md.
# REDIS_TOPOLOGY=cluster
# REDIS_CLUSTER_SEEDS=10.0.0.1:7001,10.0.0.1:7002,10.0.0.2:7003
# REDIS_SESSIONS_PREFIX=

# Redis Sentinel: standalone semantics (same four connections and DB indexes) with HA master discovery through the sentinels, REDIS_HOST/PORT become irrelevant.
# Failovers are retried while connecting as well as in-command, on a budget sized by RETRY_DEADLINE (keep it under your FPM/probe timeouts);
# socket timeouts stay bounded - never 0/infinite. Prefer REDIS_PERSISTENT=false: pooled sockets can pin a demoted master.
# Hosts take host, host:port, [v6] or [v6]:port. Full rationale and sizing: docs/redis.md.
# REDIS_TOPOLOGY=sentinel
# REDIS_SENTINEL_HOSTS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
# REDIS_SENTINEL_SERVICE=mymaster
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=
# REDIS_SENTINEL_TIMEOUT=0.5
# REDIS_SENTINEL_RETRY_ATTEMPTS=3
# REDIS_SENTINEL_RETRY_DELAY=500
# REDIS_SENTINEL_RETRY_DEADLINE=5000
# REDIS_TIMEOUT=2.0
# REDIS_READ_TIMEOUT=2.0
# REDIS_PERSISTENT=false

# --- Cache & Filesystem ----------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=
FILESYSTEM_DISK=local
# MEMCACHED_HOST=127.0.0.1

# --- Session ---------------------------------------------------------------
SESSION_DRIVER=database
# For redis sessions set SESSION_DRIVER=redis and SESSION_CONNECTION=sessions: the dedicated connection
# keeps sessions isolated so auth:flush-sessions stays precise (config/database.php).
# SESSION_CONNECTION=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie only over HTTPS.
SESSION_SECURE_COOKIE=false

# --- Queue & Horizon -------------------------------------------------------
QUEUE_CONNECTION=database

# The production path: QUEUE_CONNECTION=redis on the dedicated `queue` connection, with Horizon supervising
# the workers (dashboard at /horizon, gated by settings.manage). On Windows, use the compose `horizon` profile.
# QUEUE_CONNECTION=redis
# REDIS_QUEUE_DB=3
# HORIZON_MAX_PROCESSES=10

# --- Broadcasting ----------------------------------------------------------
BROADCAST_CONNECTION=log

# --- Mail ------------------------------------------------------------------
# docker/compose.dev.yaml ships Mailpit on these host/port values: set MAIL_MAILER=smtp to use it (UI at http://localhost:8025).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Security: HTTP boundary -----------------------------------------------
# Comma-separated origins allowed for credentialed CORS requests. Empty allows no cross-origin callers
# (right for the same-origin SPA; absent falls back to APP_URL); "*" is rejected at boot outside local/testing.
CORS_ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted; empty trusts none, and "*" is rejected at boot outside local/testing.
# Behind platform proxies that overwrite forwarded headers (Laravel Cloud, Heroku, etc.) use "REMOTE_ADDR" - trusts the immediately connecting proxy.
TRUSTED_PROXIES=REMOTE_ADDR
# Comma-separated hostnames the app may respond to; empty disables host validation (auto-skipped in local/testing).
TRUSTED_HOSTS=
# Force https:// URLs and mark requests secure when TLS terminates upstream. Required true outside local/testing.
SECURITY_FORCE_HTTPS=false
# Strict-Transport-Security header (secure responses only). Start with a small max-age and raise once edge TLS is proven,
# a long max-age already delivered to browsers cannot be recalled. Preload is effectively permanent; leave it off unless certain.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
# Content-Security-Policy header. Report-only rehearses the policy (nothing blocked): deploy with it true, flip to false after a clean click-through.
# The captcha vendor's script origin is allowlisted automatically; extra origins go on the per-directive lists below (docs/hardening.md).
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
# SECURITY_CSP_SCRIPT_SRC=
# SECURITY_CSP_STYLE_SRC=
# SECURITY_CSP_CONNECT_SRC=
# SECURITY_CSP_FRAME_SRC=
# SECURITY_CSP_IMG_SRC=
# SECURITY_CSP_FONT_SRC=

# Set to false to accept client-supplied request IDs from any origin, not just trusted proxies.
# REQUEST_ID_TRUST_PROXY_ONLY=true
# REQUEST_ID_MIN_LENGTH=8
# REQUEST_ID_MAX_LENGTH=128
# REQUEST_ID_PATTERN=/^[A-Za-z0-9._-]+$/

# --- Security: Authentication ----------------------------------------------
BCRYPT_ROUNDS=12

# Must stay null: personal access tokens carry explicit per-token expiries, and a global value would silently cap them (see config/security.php).
SANCTUM_EXPIRATION=null

LOGIN_LOCKOUT_ENABLED=true
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15

# Per-IP ceiling on the credential doors (login + two-factor), bounding password spraying the per-credential
# lockout above cannot see. Keep it well above a human's rate so shared egress IPs are not caught.
LOGIN_REQUEST_MAX_ATTEMPTS=40
LOGIN_REQUEST_DECAY_MINUTES=1

# --- Access Control ---------------------------------------------------------
# Admin impersonation (audited session swap behind the users.impersonate permission; config/access.php).
# ACCESS_IMPERSONATION_ENABLED=false

# --- Auditing & Authentication Log -----------------------------------------
AUTH_LOG_ENABLED=true
AUTH_LOG_RETENTION_DAYS=365
AUTH_LOG_NEW_DEVICE_NOTIFICATION_ENABLED=true
AUTH_LOG_LOCKOUT_NOTIFICATION_ENABLED=true
AUTH_PASSWORD_CHANGED_NOTIFICATION_ENABLED=true

# Attribute-level model audit trail (audits table); console writes audited by default, retention <= 0 keeps forever.
# AUDITING_ENABLED=true
# AUDIT_CONSOLE=true
# AUDIT_RETENTION_DAYS=180

# Access-control audit trail: admin actions on users and roles (config/access.php), pruned daily; retention <= 0 keeps forever.
# ACCESS_AUDIT_LOG_RETENTION_DAYS=730

# --- Health probes ---------------------------------------------------------
# All probes default to enabled (HEALTH_PROBE_{DATABASE,CACHE,SESSIONS,SENTINEL,QUEUE,HORIZON,STORAGE,MAIL}); critical ones also gate /up (config/health.php).
# The sentinel probe reports redundancy, not liveness - the one probe that notices failover capability is gone.
# HEALTH_QUEUE_MAX_PENDING_MINUTES=15
# HEALTH_QUEUE_MAX_FAILED_JOBS=25
# Running plain queue:work on redis instead of Horizon? Disable its probe, or health:check forever reports the master missing:
# HEALTH_PROBE_HORIZON=false

# --- Maintenance & Performance ---------------------------------------------
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

# --- Dev Tooling -----------------------------------------------------------
TELESCOPE_ENABLED=false
CLOCKWORK_ENABLE=false

# --- Frontend / Vite -------------------------------------------------------
# App name exposed to the SPA (logo, page titles). Baked at build time.
VITE_APP_NAME="${APP_NAME}"

# Dev knob: delay every API call by N ms to inspect loading skeletons. Baked at build time; unset in normal use.
# VITE_SKELETON_DELAY=2000
