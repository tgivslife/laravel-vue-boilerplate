<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The test suite's cumulative footprint outgrew the 128M CLI default; measured fine at 256M, no single offender. -->
        <ini name="memory_limit" value="256M"/>
        <env name="APP_ENV" value="testing"/>
        <!-- In-process: the file driver's storage/framework/down is shared with the dev site and any parallel test process. -->
        <env name="APP_MAINTENANCE_DRIVER" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- The developer .env may point sessions at the redis `sessions` connection or enable cluster mode; tests must not inherit either. -->
        <env name="SESSION_CONNECTION" value="null"/>
        <env name="REDIS_TOPOLOGY" value="standalone"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="CLOCKWORK_ENABLE" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- The captcha gate would 422 every door in every auth test; CaptchaTest opts back in. -->
        <env name="CAPTCHA_ENABLED" value="false"/>
    </php>
</phpunit>
